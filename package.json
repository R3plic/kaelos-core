{
  "name": "kaelos-core",
  "version": "1.0.0",
  "description": "KaelosUI — six animated tab bars on one headless TypeScript core: measured geometry, spring physics and CSS-variable theming. No animation dependencies.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tabs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "keywords": [
    "react",
    "tabs",
    "tab-bar",
    "animation",
    "spring",
    "headless",
    "ui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  }
}
